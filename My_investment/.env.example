# 토스증권 Open API 자격증명 (WTS > 설정 > Open API 에서 발급)
# https://developers.tossinvest.com/docs
#
# 이 파일을 복사해 .env 로 저장한 뒤 실제 값을 입력하세요.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Mac/Linux)

TOSSINVEST_CLIENT_ID=your_client_id_here
TOSSINVEST_CLIENT_SECRET=your_client_secret_here

# 계좌 조회 시 사용 (GET /api/v1/accounts 응답의 accountSeq)
# 미설정 시 첫 번째 계좌 자동 사용
TOSSINVEST_ACCOUNT_SEQ=1

# 기본: https://openapi.tossinvest.com
# TOSSINVEST_API_BASE_URL=https://openapi.tossinvest.com

# TOP7 자동매매 (top7_trader.py)
# TOP7_BUDGET=10000000
# TOP7_TAKE_PROFIT=0.10
# TOP7_STOP_LOSS=-0.10
# TOP7_MIN_CASH=200000
# TOP7_TOP_N=7

# 텔레그램 포트폴리오 요약 (send_portfolio_telegram.py)
# BotFather (/newbot) 토큰 · 봇과 Start 후 getUpdates 의 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
